# Copiez ce fichier en .env puis adaptez-le. Le fichier .env n'est jamais versionné.

# --- Données (voix, enregistrements, sorties) : ignoré par git ---
# VOICESTUDIO_DATA_DIR=data

# --- Transcription locale (faster-whisper) ---
VOICESTUDIO_WHISPER_MODEL=small        # tiny | base | small | medium | large-v3
VOICESTUDIO_WHISPER_DEVICE=auto        # auto = GPU si présent, sinon CPU
VOICESTUDIO_WHISPER_COMPUTE=auto
# VOICESTUDIO_VOCAB_FILE=vocab.txt     # mots-clés (lieux, noms propres) pour guider Whisper

# --- Traduction : toute API compatible OpenAI ---
# Exemple OpenRouter (le texte part vers ce service) :
# VOICESTUDIO_TRANSLATE_BASE_URL=https://openrouter.ai/api/v1
# VOICESTUDIO_TRANSLATE_API_KEY=sk-or-...
# VOICESTUDIO_TRANSLATE_MODEL=<choisissez un modèle actuel sur openrouter.ai/models>
# Exemple serveur perso (Ollama, text-generation-webui avec --api, vLLM...) :
# VOICESTUDIO_TRANSLATE_BASE_URL=http://127.0.0.1:5000/v1
# VOICESTUDIO_TRANSLATE_API_KEY=sk-dummy
# VOICESTUDIO_TRANSLATE_MODEL=default

# --- Synthèse vocale ---
# edge       = brouillon sans clonage (envoie le texte à Microsoft)
# remote     = clonage sur un serveur GPU (Colab, Space Hugging Face, VPS GPU)
# chatterbox = clonage sur CETTE machine (il faut un GPU)
VOICESTUDIO_TTS_BACKEND=edge

# --- Serveur GPU distant (TTS_BACKEND=remote) ---
# Colab : l'URL https://xxxx.gradio.live et le mot de passe affichés par le notebook
# Space Hugging Face : « votre-compte/votre-space » et un jeton d'accès
# VOICESTUDIO_REMOTE_URL=
# VOICESTUDIO_REMOTE_AUTH=moi:motdepasse
# VOICESTUDIO_REMOTE_HF_TOKEN=
